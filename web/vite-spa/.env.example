# CloudTech Frontend · Environment Variables Example
# Copy to .env.local and fill in actual values
# DO NOT commit .env.local to git (already in .gitignore)

# Backend API base URL (default: vite proxy /api/v2 → http://localhost:5099)
VITE_API_BASE=/api/v2

# Sentry / LogRocket DSN（生产错误监控 · P1+ 接入）
VITE_SENTRY_DSN=
VITE_LOGROCKET_APP_ID=

# Feature flags（开关远程控制 · P1+ 接入 LaunchDarkly / Unleash）
VITE_FEATURE_DARK_MODE=false
VITE_FEATURE_WORKFLOW_AUTOLAYOUT=true
VITE_FEATURE_I18N_ENGLISH=true

# Default locale（zh-CN | en-US）
VITE_DEFAULT_LOCALE=zh-CN

# Analytics（GA4 / Plausible）
VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=

# Build-time version (auto-injected by Vite define)
VITE_APP_VERSION=2.0.0
