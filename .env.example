# CloudTech Environment Configuration
# Copy to .env and fill in values

# === DeepSeek AI ===
DEEPSEEK_API_KEY=sk-your-deepseek-key

# === DashScope (Aliyun Tongyi) ===
DASHSCOPE_API_KEY=sk-your-dashscope-key

# === AI Video Generation ===
KLING_API_KEY=your-kling-key
KLING_ACCESS_KEY=your-kling-access-key
KLING_SECRET_KEY=your-kling-secret-key

# === Jimeng Video Generation ===
JIMENG_API_KEY=your-jimeng-key
JIMENG_ACCESS_KEY=your-jimeng-access-key
JIMENG_SECRET_KEY=your-jimeng-secret-key
JIMENG_SK_BASE64=your-jimeng-sk-base64
JIMENG_SESSION_TOKEN=your-jimeng-session-token

# === Server ===
CLOUDTECH_HOST=127.0.0.1
CLOUDTECH_PORT=5099
CLOUDTECH_WORKERS=4

# === Database ===
# sqlite (default) or postgresql
DB_TYPE=sqlite
# PostgreSQL (when DB_TYPE=postgresql)
# PG_DSN=postgresql://user:pass@localhost:5432/cloudtech

# === Auth ===
JWT_SECRET=auto-generated
JWT_EXPIRY_HOURS=24

# === Email (SMTP) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cloudtech.com

# === WeChat Pay ===
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=http://your-domain.com/api/payment/wechat/notify

# === License ===
LICENSE_PUBLIC_KEY=
